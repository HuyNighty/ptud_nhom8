# =====================================================================
# Cấu hình kết nối SQL Server cho ứng dụng N08 Nha Khoa
# 1. Sao chép file này thành  config/db.properties  (cùng thư mục).
# 2. Sửa các giá trị trong <...> theo máy của người dùng.
# 3. KHÔNG đưa file db.properties (có mật khẩu thật) lên Git / nộp bài.
#    (.gitignore đã loại trừ file này.)
# Có thể chỉ định file khác:  java -Ddb.config=duong/dan/file.properties ...
# =====================================================================

# --- Cách A: đăng nhập SQL Server Authentication (user/password) ---
# localhost:1433 là mặc định; với instance có tên dùng  localhost\\SQLEXPRESS  hoặc  localhost;instanceName=SQLEXPRESS
# encrypt=true + trustServerCertificate=true phù hợp máy cá nhân dùng chứng chỉ tự ký.
db.url=jdbc:sqlserver://localhost:1433;databaseName=N08_NhaKhoa;encrypt=true;trustServerCertificate=true
db.user=<tên_đăng_nhập_SQL_Server, ví dụ sa hoặc n08_app>
db.password=<mật_khẩu_SQL_Server_của_người_dùng>

# --- Cách B: Windows Authentication (không cần user/password) ---
# Bỏ chú thích dòng dưới, để trống db.user và db.password,
# và đặt file mssql-jdbc_auth-<phiên bản>-x64.dll (đi kèm gói driver) vào thư mục có trong PATH / java.library.path.
# db.url=jdbc:sqlserver://localhost:1433;databaseName=N08_NhaKhoa;integratedSecurity=true;encrypt=true;trustServerCertificate=true
