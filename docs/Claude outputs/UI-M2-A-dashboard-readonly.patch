diff --git a/nhakhoa/src/main/java/com/manage/nhakhoa/features/dashboard/service/DashboardDataUnavailableException.java b/nhakhoa/src/main/java/com/manage/nhakhoa/features/dashboard/service/DashboardDataUnavailableException.java
