+package com.manage.nhakhoa.features.dashboard.service;
+
+/**
+ * Khóa màn hình đích của hàng việc. CHƯA ĐỐI CHIẾU với 21 khóa menu của UI-M1 vì thư mục
+ * admin-desktop-preview/ không có trong checkout main 4d25dbf; phải đối chiếu lại ở UI-M2-B.
+ */
+public final class DashboardTargetScreens {
+
+    public static final String LICH_HEN = "LICH_HEN";
+    public static final String PHIEU_KHAM = "PHIEU_KHAM";
+    public static final String HOA_DON = "HOA_DON";
+    public static final String PHAN_CONG_CA = "PHAN_CONG_CA";
+    public static final String TON_KHO = "TON_KHO";
+    public static final String DIEU_CHINH_KHO = "DIEU_CHINH_KHO";
+    public static final String CAP_CUU = "CAP_CUU";
+    public static final String KE_HOACH_DIEU_TRI = "KE_HOACH_DIEU_TRI";
+
+    private DashboardTargetScreens() {
+    }
+}
diff --git a/nhakhoa/src/main/java/com/manage/nhakhoa/features/dashboard/service/DashboardThresholds.java b/nhakhoa/src/main/java/com/manage/nhakhoa/features/dashboard/service/DashboardThresholds.java
